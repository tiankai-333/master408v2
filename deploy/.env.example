# Master408 v2 生产环境变量模板（PD-03：本文件只含键名与占位）
# 用法：cp .env.example .env 后填真实值；.env 只存在于部署机，不入 Git
# 生成密钥类值的推荐方式：openssl rand -base64 32

# ---- 镜像分发（A-03）----
# 服务器拉取走 VPC 端点（实测内网可达）；本机推送走公网端点，本文件给服务器用
REGISTRY=crpi-z118pytqkuhi1rn1.cn-wulanchabu.personal.cr.aliyuncs.com
# 部署版本 = git 短 SHA（PD-08 版本追溯），生产禁用 latest
TAG=请填git短SHA

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=请填随机长密码
# 应用账号密码，与 compose 中 DB_PASSWORD 同源
MYSQL_PASSWORD=请填随机长密码

# ---- Redis ----
REDIS_PASSWORD=请填随机长密码

# ---- AI 运行时（tech-stack：Key 只来自环境变量，不入日志不入 Git）----
# 密钥主密钥：用于本地加密存储的 AI 供应商凭据，首次部署生成后不可随意更换（已加密数据将不可解）
AI_SECRET_MASTER_KEY=请填openssl_random_base64_32
# 模型供应商 Key（当前默认 GLM）
AI_API_KEY=请填模型供应商Key
# 以下留空则使用 application.yml 默认值
AI_CHAT_API_KEY=
AI_EMBEDDING_API_KEY=
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_ENGINE=spring

# ---- RAG / Qdrant（A-02：首期关闭向量，走词法回退）----
AI_RAG_VECTOR_ENABLED=false
AI_RAG_COLLECTION=xzs_408_chunks_spring_v1
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_API_KEY=

# ---- 登录 RSA 密钥（实测仅 /api/test/** 调试接口使用；生产禁用该入口，可留空）----
AUTH_RSA_PUBLIC_KEY=
AUTH_RSA_PRIVATE_KEY=

# ---- 可选第三方（不用则留空）----
QINIU_URL=
QINIU_BUCKET=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# ---- 微信小程序（specs/2026-09-30-wx-domain-update WX-03：小程序登录必需，非可选项）----
# 缺失时 /api/wx/student/auth/* 显式返回配置错误（AuthController 校验 secret 非空）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- JVM 内存（对应 MEMORY-BUDGET.md，2 GiB 机器实测后再校准）----
JAVA_OPTS=-XX:MaxRAMPercentage=45.0 -XX:InitialRAMPercentage=25.0 -XX:MaxMetaspaceSize=192m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp
